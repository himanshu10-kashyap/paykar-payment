NODE_ENV=development

# Must match the frontend dev proxy target (frontend/vite.config.js API_TARGET).
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paykar_gateway
DB_USER=
DB_PASSWORD=

PAYKAR_ENV=sandbox
PAYKAR_BASE_URL=https://paykar.in/api/v1

# Required for a real checkout to be created. Leave empty to boot the server
# anyway; payment initiation then fails with 503 PAYKAR_NOT_CONFIGURED.
#
# The Paykar dashboard names these inconsistently, so each one is also accepted
# under its alias (listed in brackets). Aliases are only a fallback: the name
# without brackets wins.
#
#   X-Merchant-Key  <- PAYKAR_MERCHANT_KEY [PAYKAR_MERCHANT_ID]
#   X-API-Key       <- PAYKAR_API_KEY
#   IPN signing     <- PAYKAR_API_SECRET [PAYKAR_SECRET_KEY]
PAYKAR_MERCHANT_KEY=
PAYKAR_API_KEY=
PAYKAR_API_SECRET=

FRONTEND_URL=http://localhost:5173

# Comma-separated extra browser origins that may call the API. Needed in dev
# because Vite moves to the next free port (5174, 5175, ...) when 5173 is busy,
# and a page on a port missing from this list fails with an opaque CORS error.
# Each entry is auto-widened to its 127.0.0.1 twin.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175

# Paykar calls this from its own servers, so a loopback address is never
# reachable in practice. Use a public HTTPS tunnel URL for real webhook traffic.
PAYKAR_WEBHOOK_URL=http://localhost:4000/api/webhooks/paykar

# Optional
# CUSTOMER_SESSION_TTL_MS=600000
# CUSTOMER_SESSION_MAX=5000
# LOG_LEVEL=info